rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, create, update: if ownsUserDocument(userId);
      allow delete: if false;

      match /favorites/{stationId} {
        allow read, write: if ownsUserDocument(userId);
      }
    }

    match /chargingSessions/{sessionId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read, update: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow delete: if false;
    }
  }
}
